# Copy to .env and fill in. Never commit .env.

# ---- AI (free tiers) ----
# Groq: https://console.groq.com/keys     (primary, ~1-1.5 s per check)
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey   (automatic fallback)
GEMINI_API_KEY=
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-lite-latest
# LLM_PROVIDERS=groq,gemini,ollama

# ---- PayPal sandbox ----
# developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App (Merchant).
# Link the app to a sandbox BUSINESS account whose country is United States
# (sandbox accounts created in some countries, e.g. India, cannot send Payouts).
# Tick "Payouts" under the app's Features.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox PERSONAL account used to approve payments as the buyer (US country recommended)
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
# Sandbox account that receives seller payouts in the demo
SANDBOX_BUYER2_EMAIL=

# ---- Demo tuning ----
# Cooling-off for paused payments, in seconds (production would be ~24h)
COOLING_OFF_SECONDS=120
PLATFORM_FEE_PCT=5
